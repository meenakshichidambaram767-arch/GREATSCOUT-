# Environment Configuration
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL + pgvector for Docker/Production; SQLite async for lightweight zero-dependency local dev)
DATABASE_URL=sqlite+aiosqlite:///./greatscout.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/greatscout

# AI Provider Configuration (heuristic | openai | gemini | anthropic)
# Default is 'heuristic' which runs zero-cost locally without requiring API keys
AI_PROVIDER=heuristic
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Upstream Live APIs (Optional - Demo mode works out-of-the-box without keys)
PRODUCT_HUNT_API_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=GreatScoutMarketIntel/1.0
